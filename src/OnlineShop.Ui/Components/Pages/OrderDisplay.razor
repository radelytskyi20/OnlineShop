<div class="row justify-content-center my-2">
    <div class="col-10 border border border-2 rounded-1 p-3 my-2">
        <div class="text-center fs-4 fw-semibold">@Order.Id</div>
        <div class="row justify-content-center text-center fst-italic fw-semibold pt-2 text-break">
            <div class="col-4">Name</div>
            <div class="col-4">Quantity</div>
            <div class="col-4">Total</div>
        </div>
        <div class="row justify-content-center text-break text-center">
            @foreach (var article in Order.Articles)
            {
                <OrderedArticleDisplay Article="article"></OrderedArticleDisplay>
            }
        </div>

        <div class="row align-items-center pt-4 text-center p-0">
            <div class="col">
                <div class="fst-italic pb-1 fw-semibold">User</div>
                <div>@Order.User.FirstName</div>
                <div>@Order.User.LastName</div>
            </div>
            <div class="col">
                <div class="fst-italic pb-1 fw-semibold">Address</div>
                <div>@Order.User.DeliveryAddress.AddressLine1</div>
                <div>@Order.User.DeliveryAddress.PostalCode @Order.User.DeliveryAddress.City, @Order.User.DeliveryAddress.Country</div>
            </div>
            <div class="col">
                <div class="fst-italic pb-1 fw-semibold">Total</div>
                <div>@Order.Articles.Sum(a => a.Total).ToString("0.00")</div>
            </div>
            <div class="col">
                <div class="fst-italic pb-1 fw-semibold">Time</div>
                <div>Created: @Order.Created</div>
                @if (Order.Modified != DateTime.MinValue)
                {
                    <div>Modified: @Order.Modified</div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    
    [EditorRequired]
    [Parameter]
    public OrderView Order { get; set; } = new();
}
